# Build nfs-walker as a fully static musl binary.
#
# Uses Alpine Linux (musl-based) with static C linking. The resulting
# binary works on ANY Linux system without needing a matching glibc.
# Output is sharded Parquet — there is no RocksDB dependency.
#
# Usage:
#   podman build -f Dockerfile.musl -t nfs-walker-musl .
#   podman run --rm nfs-walker-musl cat /app/target/x86_64-unknown-linux-musl/release-debug/nfs-walker > nfs-walker
#   chmod +x nfs-walker

FROM docker.io/library/rust:1.92.0-alpine as builder

# Install build dependencies for musl + libnfs + parquet codecs.
RUN apk add --no-cache \
    build-base \
    musl-dev \
    git \
    autoconf \
    automake \
    libtool \
    pkgconf \
    zstd-dev \
    zstd-static \
    zlib-dev \
    zlib-static

WORKDIR /app

# Build libnfs from source as a static library
# Note: Must use master branch - the _task functions were added after 5.0.3
RUN git clone https://github.com/sahlberg/libnfs.git && \
    cd libnfs && \
    git checkout master && \
    ./bootstrap && \
    ./configure --prefix=/usr/local --disable-examples --disable-utils --disable-shared --enable-static --without-libkrb5 && \
    make -j$(nproc) && \
    make install && \
    cd .. && \
    rm -rf libnfs

# Set up for static musl build.
#
# RUSTFLAGS here (an env var) OVERRIDES the per-target rustflags in
# .cargo/config.toml rather than merging, so every flag the musl build needs
# must be listed here:
#   +crt-static  static C runtime (the whole point of the musl build)
#   +aes,+sse2   gxhash needs AES + SSE2 intrinsics at compile time and has no
#                portable fallback. sse2 is baseline on x86-64; aes (AES-NI) is
#                present on essentially all server CPUs since ~2010. Using the
#                explicit features (not target-cpu=native) keeps the binary
#                portable instead of pinning it to the build host's exact CPU.
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
ENV RUSTFLAGS="-C target-feature=+crt-static,+aes,+sse2"

# Add musl target
RUN rustup target add x86_64-unknown-linux-musl

# Copy project source code
COPY . .

# Clean any stale Cargo.lock
RUN rm -f Cargo.lock

# Build the static musl binary. The profile is parameterized:
#   PROFILE=release        -> stripped, LTO'd binary for distribution (GH releases)
#   PROFILE=release-debug  -> keeps line tables + symtab for crash-symbolication
#                             during the prod-segfault investigation (default,
#                             preserves the `make docker-musl` extraction path).
ARG PROFILE=release-debug
RUN cargo build --profile ${PROFILE} --target x86_64-unknown-linux-musl

# The final binary is at (output dir tracks the profile name):
#   PROFILE=release       -> /app/target/x86_64-unknown-linux-musl/release/nfs-walker
#   PROFILE=release-debug -> /app/target/x86_64-unknown-linux-musl/release-debug/nfs-walker
